{
  "name": "library-information-system",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --workspace frontend run build",
    "db:migrate": "npm --workspace backend run db:migrate",
    "db:migrate:undo": "npm --workspace backend run db:migrate:undo",
    "db:seed": "npm --workspace backend run db:seed",
    "db:seed:undo": "npm --workspace backend run db:seed:undo"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
